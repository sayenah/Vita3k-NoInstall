<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sayenah.vita3knoinstall</id>
  <name>Vita3K NoInstall</name>
  <developer id="io.github.sayenah">
    <name>Vita3K NoInstall contributors</name>
    <url>https://github.com/sayenah/Vita3k-NoInstall/graphs/contributors</url>
  </developer>
  <summary>PlayStation Vita emulator that plays games without installing them</summary>
  <branding>
    <color type="primary" scheme_preference="light">#f05f40</color>
    <color type="primary" scheme_preference="dark">#181818</color>
  </branding>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0</project_license>
  <launchable type="desktop-id">io.github.sayenah.vita3knoinstall.desktop</launchable>
  <url type="homepage">https://vita3k.org/</url>
  <url type="vcs-browser">https://github.com/sayenah/Vita3k-NoInstall</url>
  <url type="bugtracker">https://github.com/sayenah/Vita3k-NoInstall/issues</url>
  <url type="contact">https://discord.gg/6aGwQzh</url>
  <url type="donation">https://ko-fi.com/vita3k</url>
  <url type="faq">https://vita3k.org/faq</url>
  <url type="help">https://vita3k.org/quickstart</url>
  <description>
    <p>Vita3K NoInstall is a fork of Vita3K, the open-source PlayStation Vita emulator, that plays games straight
      from .zip, .7z and .pkg files without installing them, and includes the Vita3K-Plus compatibility fixes.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image type="source">https://vita3k.org/img/portfolio/fullsize/1.webp</image>
      <caption>Persona 4 Golden</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://vita3k.org/img/portfolio/fullsize/2.webp</image>
      <caption>Freedom Wars</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://vita3k.org/img/portfolio/fullsize/3.webp</image>
      <caption>Hatsune Miku: Project Diva X</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://vita3k.org/img/portfolio/fullsize/4.webp</image>
      <caption>Muramasa Rebirth</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://vita3k.org/img/portfolio/fullsize/5.webp</image>
      <caption>Borderlands 2</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://vita3k.org/img/portfolio/fullsize/6.webp</image>
      <caption>Soul Sacrifice Delta</caption>
    </screenshot>
  </screenshots>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <recommends>
    <control>gamepad</control>
  </recommends>
  <provides>
    <binary>Vita3K</binary>
  </provides>
  <keywords>
    <keyword>emulator</keyword>
    <keyword>retro</keyword>
  </keywords>
  <releases>
    @FREEDESKTOP_RELEASE_INFO@
  </releases>
  <content_rating type="oars-1.1"/>
</component>
